datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id        String   @id @default(cuid())
  title     String
  createdAt DateTime @default(now())
  assets    Asset[]
  scripts   Script[]
  clips     Clip[]
}

model Asset {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  name      String
  type      String
  url       String
  duration  Float?
  createdAt DateTime @default(now())
}

model Script {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  title     String
  content   String
  hooks     String
  createdAt DateTime @default(now())
}

model Clip {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id])
  title     String
  videoUrl  String
  startTime Float
  endTime   Float
  platform  String
  createdAt DateTime @default(now())
}
